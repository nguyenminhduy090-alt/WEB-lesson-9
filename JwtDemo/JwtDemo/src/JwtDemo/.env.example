# F5 in Development creates .env automatically; this template contains no real secret.
# If configuring manually, fill JWT_KEY with at least 32 random UTF-8 bytes.
JWT_KEY=
JWT_ISSUER=JwtDemo
JWT_AUDIENCE=JwtDemo.Web
JWT_MINUTES=15
DATABASE_PATH=App_Data/jwtdemo.db
# Demo accounts are created only in Development when this is true.
SEED_DEMO=true
